{
  "name": "gh-ai-review",
  "version": "1.2.15",
  "description": "Experimental CLI for advisory GitHub PR reviews through Hugging Face",
  "main": "dist/index.js",
  "bin": {
    "gh-ai-review": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/claim-evidence.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "github",
    "cli",
    "gh-extension",
    "ai",
    "code-review",
    "pull-request",
    "llm",
    "huggingface",
    "code-reviewer",
    "automation"
  ],
  "author": "turfin-logic",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
